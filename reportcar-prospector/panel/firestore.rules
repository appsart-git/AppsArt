rules_version = '2';
// Solo entran los usuarios dados de alta en usuarios/{uid} (se crean a mano en la consola).
// Para sumar a alguien: que inicie sesión una vez, copiar su UID del panel y crear usuarios/<UID> con { rol: "..." }.
service cloud.firestore {
  match /databases/{database}/documents {
    function autorizado() {
      return request.auth != null && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /negocios/{id} {
      allow read, write: if autorizado();
      match /eventos/{ev} { allow read, create: if autorizado(); allow update, delete: if false; }
      match /mensajes/{paso} { allow read, write: if autorizado(); }
    }

    match /config/{doc} { allow read, write: if autorizado(); }
    match /rubros/{id} { allow read, write: if autorizado(); }
    // Lo escribe el generador (Admin SDK, no pasa por estas reglas); el panel solo lo lee.
    match /generador/{id} { allow read: if autorizado(); allow write: if false; }
  }
}
