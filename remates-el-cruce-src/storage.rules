rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // fotos de productos: publicas para lectura (el catalogo las muestra sin login).
    // Escritura sin autenticacion, mismo criterio que firestore.rules — ver el
    // comentario ahi sobre el trade-off de index.html (herramienta interna) sin login.
    match /productos/{codigo}/{archivo} {
      allow read: if true;
      allow write: if request.resource.size < 8 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
